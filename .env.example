# === AI Research Agent Configuration ===
# Copy this file to .env:  cp .env.example .env
# Then edit the values below.

# App
APP_NAME=AI Research Agent
DEBUG=True
SECRET_KEY=replace-with-random-string-at-least-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_research_agent
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_research_agent

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings (HuggingFace — runs locally, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FAISS Vector Store
FAISS_INDEX_PATH=./faiss_index

# JWT Auth
JWT_SECRET_KEY=replace-with-another-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Document Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
